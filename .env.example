# ---------------------------------------------------------------- database
# MySQL 8 connection URL. Percent-encode special characters in user/password values.
# GoDaddy cPanel commonly uses localhost and prefixes database/user names with the account name.
MYSQL_URL=mysql://cpanel_user:change-me@localhost:3306/cpanel_ship_print_esell
# Dedicated disposable database for real integration tests; its name MUST end in _test.
MYSQL_TEST_URL=mysql://local_test_user:change-me@127.0.0.1:3306/ship_print_esell_test
# Set to true only when the provider requires TLS.
DATABASE_SSL=false

# ------------------------------------------------------------------ the app
# Public base URL. Required for password reset links to work.
APP_URL=https://quotes.example.com

# Owner session lifetime in hours, and password reset link lifetime in minutes.
SESSION_TTL_HOURS=12
PASSWORD_RESET_TTL_MINUTES=60

# --------------------------------------------------------------------- mail
# Standard SMTP. Works with Resend, Amazon SES, Postmark, SendGrid, or a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The address notifications are sent from. Must be authorized by the SMTP provider.
EMAIL_FROM=quotes@example.com

# Where new quote requests are delivered.
QUOTE_NOTIFICATION_TO=owner@example.com

# Maximum complete MIME message accepted by BOTH the sender and receiving mailbox.
# Base64 and MIME overhead are included. Keep the raw customer-facing cap at 75 MB,
# but set this to the lower real service limit when necessary (bytes).
MAX_EMAIL_MESSAGE_BYTES=115343360

# ------------------------------------------------------- development only
# Stores requests on disk when MYSQL_URL is absent. Never enable in production.
ENABLE_LOCAL_DEV_INTAKE=false
# Shows placeholder fixture pricing. Never enable in production.
NEXT_PUBLIC_ENABLE_DEMO_PRICING=false

# --------------------------------------------------------------- operations
# Where scripts/backup.sh writes metadata backups, and how long to keep them.
BACKUP_DIR=/var/backups/ship-print-esell
BACKUP_RETAIN_DAYS=30

# Set false only for trusted HTTP LAN testing; production HTTPS defaults true.
SESSION_COOKIE_SECURE=true
