# ---------------------------------------------------------------- database
# Preferred for local development: a MySQL 8 URL. Percent-encode special characters.
# In production, configure EITHER MYSQL_URL OR the complete DB_* set below, not both.
MYSQL_URL=mysql://local_user:change-me@127.0.0.1:3306/ship_print_esell
# GoDaddy-friendly alternative when its UI supplies separate database fields.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional pool/TLS controls. Set DATABASE_SSL=true only when the provider requires TLS.
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# Development/test only. Its database name MUST end in _test.
MYSQL_TEST_URL=mysql://local_test_user:change-me@127.0.0.1:3306/ship_print_esell_test

# ------------------------------------------------------------------ the app
# Public origin. Production requires HTTPS with no credentials, path, query, or fragment.
APP_URL=https://quotes.example.com

# Required only for the one-time /admin/setup flow. Generate at least 32 random
# characters and enter it only through the host's private secrets UI. Remove it
# after the first owner is created; the database marker keeps setup closed.
FIRST_OWNER_SETUP_SECRET=

# Owner session lifetime in hours, password reset link lifetime in minutes, and
# the bounded neutral-response floor used to reduce account-enumeration timing.
SESSION_TTL_HOURS=12
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_RESPONSE_FLOOR_MS=750
# Separate 32+ character secret shared by the app and scheduled maintenance
# process. It authorizes durable password-reset outbox recovery; never log it.
RESET_DELIVERY_WORKER_SECRET=

# --------------------------------------------------------------------- mail
# Preferred HTTPS transport on Airo/GoDaddy. When set, this takes precedence over
# SMTP and Gmail API values. Keep the key only in the host's private secrets UI.
RESEND_API_KEY=

# Legacy alternatives retained for portable deployments. SMTP may be blocked by
# managed hosts. Gmail API needs a private persistent writable token path.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
GMAIL_OAUTH_TOKENS_PATH=

# Split senders must each be authorized on a Resend-verified domain. The shop
# notification can use a sending subdomain; customer replies should go to the
# customer-facing address used for confirmations.
QUOTE_NOTIFICATION_FROM=quotes@notify.example.com
CUSTOMER_CONFIRMATION_FROM=info@example.com
# Backward-compatible fallback for either sender when its split variable is absent.
EMAIL_FROM=

# Where new quote requests are delivered.
QUOTE_NOTIFICATION_TO=owner@example.com

# Resend allows 40 MB after Base64 attachment encoding. This is an encoded-message
# ceiling, not 40 MB of raw uploads; the app derives a lower raw cap automatically.
# Use an even lower value when the receiving mailbox requires it.
MAX_EMAIL_MESSAGE_BYTES=40000000

# Resend Free currently allows 3,000 emails/month and 100/day. A successful quote
# normally sends two messages, so budget roughly 50 quote requests/day before resets.

# ------------------------------------------------------- development only
# Stores requests on disk when no database credentials are present. Never enable in production.
ENABLE_LOCAL_DEV_INTAKE=false
# Shows placeholder fixture pricing. Never enable in production.
NEXT_PUBLIC_ENABLE_DEMO_PRICING=false

# --------------------------------------------------------------- operations
# Where scripts/backup.sh writes metadata backups, and how long to keep them.
BACKUP_DIR=/var/backups/ship-print-esell
BACKUP_RETAIN_DAYS=30

# Set false only for trusted HTTP LAN testing; production HTTPS defaults true.
SESSION_COOKIE_SECURE=true
