{
  "name": "ship-print-esell",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "npm run db:init && next dev",
    "setup:local": "node scripts/setup-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "create-owner": "node scripts/create-owner.mjs",
    "db:init": "node --env-file-if-exists=.env.local scripts/init-db.mjs",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "maintenance": "node scripts/maintenance.mjs",
    "deploy": "bash scripts/deploy.sh",
    "verify:full": "node scripts/verify-full.mjs",
    "verify:ops": "node scripts/verify-ops.mjs",
    "verify:all": "npm run typecheck && npm run lint && npm test && npm run verify:e2e && npm run verify:ops && npm run verify:full && npm run build"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "mysql2": "^3.24.3",
    "next": "16.3.4",
    "nodemailer": "^9.1.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^26.1.0",
    "smtp-server": "^3.19.7",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
